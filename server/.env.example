# DevSync server configuration — copy to server/.env for local development
PORT=5000
NODE_ENV=development

# Primary MongoDB connection. In production, Atlas connection string is required.
# In local dev, falls back to local MongoDB or in-memory MongoDB.
MONGODB_URI=mongodb://127.0.0.1:27017/devsync

# JWT secret (7-day tokens). Must be securely set in production (refuses "change-me").
JWT_SECRET=change-me-to-a-long-random-secret

# Frontend origin for CORS
CLIENT_ORIGIN=http://localhost:5173

# Admin approval emails, comma-separated (required in production)
ADMIN_EMAILS=admin@devsync.demo

# Feature Flags
FEATURE_MESSAGING=true
FEATURE_IDEAS=true

# Email verification (optional: leave empty for local development simulation)
RESEND_API_KEY=
MAIL_FROM=DevSync <verify@devsync.app>

# Optional Google OAuth client ID for Sign in with Google
GOOGLE_CLIENT_ID=
